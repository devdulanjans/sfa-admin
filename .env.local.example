# Copy this file to .env.local and fill in your values
# Never commit .env.local to source control

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# For production deployment, set this to your domain:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Google Maps JavaScript API key — used by the Sales Routes map (/routes, /routes/assign).
# Restrict it to your admin domain(s) (HTTP referrer restriction) in Google Cloud Console.
# Without it the route pages still work, the map just shows a notice instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
